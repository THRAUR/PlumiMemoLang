# LF in the repository and on checkout, on every system, so a clone on Windows runs
# the same files the tests ran. Windows batch files are the exception: cmd.exe
# reads them most reliably with CRLF.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch these.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.pptx binary
