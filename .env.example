# Copy to .env — every value is optional.

# OpenRouter key. You can also paste it in Settings inside the app; that copy
# lives in data/settings.json and wins over this one.
OPENROUTER_API_KEY=

# Where the app listens. It binds to this machine only by default; set
# MEMOLANG_HOST=0.0.0.0 to reach it from your phone on the same Wi-Fi or
# over Tailscale. (The generic HOST variable is ignored on purpose.)
MEMOLANG_PORT=3080
MEMOLANG_HOST=127.0.0.1

# Where your words, lessons, notes and progress are stored (JSON files).
# Back up this folder and you have backed up everything.
MEMOLANG_DATA_DIR=./data
